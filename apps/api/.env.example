# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Replica Set URI (Bắt buộc replica set cho multi-document transactions)
MONGODB_URI=mongodb://localhost:27017/sports_complex?replicaSet=rs0

# Redis Configuration (Dùng cho khóa chống trùng, BullMQ, Idempotency)
# Dùng chuỗi kết nối Upstash: rediss://default:xxxx@xxxx.upstash.io:6379
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=1d

# Internal Settings
IDEMPOTENCY_TTL_SECONDS=86400

# PayOS Configuration
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

